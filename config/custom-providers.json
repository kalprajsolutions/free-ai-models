{
  "_comment": "Manually-maintained free-model providers for scripts/fetch-models.js. Use this for gateways/models that have no public catalog API to auto-discover (e.g. Pollinations). Gateways WITH a public /models endpoint live in config/sources.json instead and are fetched automatically — AIHubMix and TokenRouter are already there; if a gateway needs an API key to list models, set its 'api_key_env' env var and it will be fetched too. Entries here always override an auto-fetched entry with the same 'id'.",
  "_schema": {
    "id":             "unique-slug/model-name",
    "name":           "Display name shown in the README table",
    "provider":       "Provider / company name",
    "context_window": "Context window size in tokens (number)",
    "modalities":     "Array of: text, image, file",
    "rate_limit":     "Human-readable rate limit string",
    "notes":          "Optional short note",
    "source":         "URL to the provider / model page"
  },
